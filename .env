APP_NAME="SIMLAP-Riset"
APP_ENV=local
APP_DEBUG=1
APP_KEY=local-dev-key-please-replace-with-random-32bytes-0123456789
APP_HMAC_KEY=local-dev-hmac-key-please-replace-with-random-value-0123456789

# Demo cepat: SQLite (tidak perlu server MySQL).
# Untuk produksi sesuai PRD, ubah DB_DRIVER=mysql lalu jalankan installer.
DB_DRIVER=sqlite
DB_SQLITE_PATH=storage/database.sqlite

# Konfigurasi MySQL (dipakai bila DB_DRIVER=mysql)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=simlap_riset
DB_USERNAME=root
DB_PASSWORD=

LPPM_WHATSAPP=6281234567890
LPPM_EMAIL=lppm@kampus.ac.id

ENABLE_DUAL_APPROVAL=1
ENABLE_CAPTCHA=0
CAPTCHA_SITE_KEY=
CAPTCHA_SECRET=
