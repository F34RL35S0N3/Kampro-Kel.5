# ============================================================
# SIMLAP-Riset — contoh konfigurasi lingkungan
# Salin menjadi .env lalu sesuaikan nilainya.
# ============================================================

APP_NAME="SIMLAP-Riset"
APP_ENV=production
APP_DEBUG=0
APP_KEY=ganti-dengan-32-byte-acak-minimal-32-karakter

# --- Target produksi (PRD §8.1): MySQL / MariaDB, InnoDB ---
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=simlap_riset
DB_USERNAME=root
DB_PASSWORD=

# --- Alternatif demo tanpa server MySQL (SQLite) ---
# DB_DRIVER=sqlite
# DB_SQLITE_PATH=storage/database.sqlite

# --- Kontak bantuan LPPM (tampil di UI) ---
LPPM_WHATSAPP=6281234567890
LPPM_EMAIL=lppm@kampus.ac.id

# --- Fitur tingkat lanjut (ASVS L3) ---
ENABLE_DUAL_APPROVAL=1
ENABLE_CAPTCHA=0
CAPTCHA_SITE_KEY=
CAPTCHA_SECRET=

# --- Kunci aplikasi (HMAC alur & hash IP) ---
APP_HMAC_KEY=ganti-dengan-kunci-hmac-acak-panjang
